set -euo pipefail

REVNG="$1"
MODEL="$2"
ASSEMBLY="$3"
FUNCTION="$4"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

printf '8*******4***hello world\0abc\0\0\0\0\0\0\0\xf0\xff' > "$TMP/binary"
#       ^       ^   ^           ^   ^
#       |       |   |           |   8 bytes (-inf) at offset 20
#       |       |   |           const uint8_t offset_16[4] ("abc\0")
#       |       |   const uint8_t offset_4[12] ("hello world\0")
#       |       uint32_t offset_0
#       seg_0x401000 (executable)

SHA=$(sha256sum "$TMP/binary" | awk '{print $1}')

tar -c -f "$TMP/binaries-inner.tar" --transform "s;.*;binaries/$SHA;" "$TMP/binary"
tar -c -f "$TMP/binaries-outer.tar" --transform 's;.*;/binary;' "$TMP/binaries-inner.tar"
tar -c -f "$TMP/functions.tar" --transform "s;.*;$FUNCTION;" "$ASSEMBLY"

"$REVNG" pipeline run-pipe emit-strings --format=tar \
  "$MODEL" \
  "$TMP/binaries-outer.tar" \
  "$TMP/functions.tar" \
  "$TMP/strings.tar"

"$REVNG" pipeline run-pipe import-descriptive-function-info --format=tar \
  "$MODEL" \
  "$TMP/strings.tar" \
  "$TMP/named.tar"

"$REVNG" pipeline run-pipe emit-c \
  "$MODEL" \
  "$TMP/named.tar" \
  /dev/stdout | "$REVNG" ptml
